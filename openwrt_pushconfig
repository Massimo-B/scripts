#!/usr/bin/env bash
# BEGIN SCRIPT VERSION
# Source version: 2026-10-16 (Git 239c893)
if [[ "${BASH_SOURCE[0]}" == "$0" && "${1-}" == --version ]]; then
    printf '%s %s (Git %s)\n' 'openwrt_pushconfig' '2026-10-16' '239c893'
    exit 0
fi
# END SCRIPT VERSION
# Restore UCI and APK configuration, install requested packages, then reload services.
set -euo pipefail
umask 077

usage() {
    cat <<'EOF'
Usage: openwrt_pushconfig [--name NAME] [--force] SSH_HOST REPOSITORY

Copy REPOSITORY/NAME/etc/config and optional etc/apk to OpenWrt over SSH.
Restore APK repositories and keys, then synchronize packages with saved world.
Packages no longer required by world or its dependencies are removed.
The router hostname must equal NAME; --force bypasses this check.
NAME defaults to openwrt. Missing secret options are retained from the router.
Explicit overrides belong in ignored NAME/secrets/PACKAGE UCI files; known
secret options in public etc/config files are rejected.
Files absent locally are retained on the router. Old [REDACTED] snapshots
must be replaced with complete configuration files before pushing.

The router validates the files with UCI, backs up /etc/config under /root,
installs and verifies the upload, and schedules service reloads. Network
changes may disconnect clients or change the router address.

Options:
  --force      Skip the router hostname check
  --name NAME  Source directory name inside the repository
  --version    Show source date and Git commit ID
  -h, --help   Show this help
EOF
}

die() { printf 'openwrt_pushconfig: %s\n' "$*" >&2; exit 1; }

name=openwrt
force=0
while (($#)); do
    case "$1" in
        --name)
            (($# >= 2)) || die '--name requires a value'
            name=$2
            shift 2
            ;;
        --force) force=1; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) die "Unknown option: $1" ;;
        *) break ;;
    esac
done
(($# == 2)) || { usage >&2; exit 1; }
[[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die 'Invalid NAME'
host=$1
[[ -n "$host" && "$host" != -* ]] || die 'Invalid SSH host'
for command in ssh git tar cat mktemp realpath grep find chmod; do
    command -v "$command" >/dev/null || die "Missing dependency: $command"
done
repo=$(git -C "$2" rev-parse --show-toplevel) || die 'REPOSITORY must be a Git working tree'
repo=$(realpath -- "$repo")
source_config="$repo/$name/etc/config"
for path in "$repo/$name" "$repo/$name/etc" "$source_config"; do
    [[ -d "$path" && ! -L "$path" ]] || die "Expected a real directory: $path"
done
# Resolve the companion even when the scripts are installed with a prefix.
helper="${BASH_SOURCE[0]%_*}_secrets"
if [[ ! -f "$helper" ]]; then
    helper="$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/openwrt_secrets"
fi
[[ -f "$helper" ]] || die 'Missing companion script: openwrt_secrets'
remote_secrets=$(bash "$helper" --remote-source)
remote_bootstrap=$(bash "$helper" --ssh-bootstrap)
policy="$repo/$name/secret-options"
[[ ! -L "$policy" && ( ! -e "$policy" || -f "$policy" ) ]] || die 'secret-options must be a regular file'
[[ -z $(git -C "$repo" ls-files -- "$name/secrets") ]] || die 'Secrets are already tracked by Git; remove them from the index before continuing'

files=()
shopt -s nullglob dotglob
for file in "$source_config"/*; do
    package=${file##*/}
    [[ "$package" == .git ]] && continue
    [[ "$package" =~ ^[a-zA-Z0-9_]+$ && -f "$file" && ! -L "$file" ]] || die "Expected a regular UCI package: $package"
    if grep -Fq '[REDACTED]' "$file"; then
        die "Package $package contains old [REDACTED] placeholders; restore complete values before pushing"
    fi
    files+=("$package")
done
((${#files[@]})) || die 'No configuration files to push'
source_apk="$repo/$name/etc/apk"
archive_files=()
for file in "${files[@]}"; do archive_files+=("etc/config/$file"); done
if [[ -e "$source_apk" || -L "$source_apk" ]]; then
    [[ -d "$source_apk" && ! -L "$source_apk" ]] || die 'Expected a real APK directory'
    while IFS= read -r -d '' file; do
        relative=${file#"$source_apk"/}
        [[ "$relative" == .git || "$relative" == .git/* ]] && continue
        [[ "$relative" =~ ^([a-zA-Z0-9_+-][a-zA-Z0-9._+-]*/)*[a-zA-Z0-9_+-][a-zA-Z0-9._+-]*$ && ! -L "$file" && ( -d "$file" || -f "$file" ) ]] || die "Invalid APK path: $relative"
        [[ ! -f "$file" ]] || archive_files+=("etc/apk/$relative")
    done < <(find "$source_apk" -mindepth 1 -print0)
    [[ -f "$source_apk/world" ]] || die 'APK snapshot is missing world'
fi
# Only regular files in the ignored overrides directory can be uploaded.
source_secrets="$repo/$name/secrets"
if [[ -e "$source_secrets" || -L "$source_secrets" ]]; then
    [[ -d "$source_secrets" && ! -L "$source_secrets" ]] || die 'Expected a real secrets directory'
    git -C "$repo" check-ignore -q -- "$name/secrets/.openwrt-check" || die 'NAME/secrets/ must be ignored by Git (add /secrets/ to NAME/.gitignore)'
    chmod 700 -- "$source_secrets"
    for file in "$source_secrets"/*; do
        package=${file##*/}
        [[ "$package" =~ ^[a-zA-Z0-9_]+$ && -f "$file" && ! -L "$file" ]] || die 'Expected regular secret override files'
        [[ -f "$source_config/$package" ]] || die "Secret override has no public configuration: $package"
        git -C "$repo" check-ignore -q -- "$name/secrets/$package" || die "Secret override must be ignored by Git: secrets/$package"
        chmod 600 -- "$file"
        archive_files+=("secrets/$package")
    done
fi
for metadata in secret-options secret-paths; do
    file="$repo/$name/$metadata"
    [[ ! -L "$file" && ( ! -e "$file" || -f "$file" ) ]] || die "Expected a regular $metadata file"
    [[ ! -f "$file" ]] || archive_files+=("$metadata")
done
# Check in the transfer/installation session before changing either side.
# NAME is restricted to safe characters by the argument validation above.
remote_guard="if [ '$force' = 0 ]; then
    IFS= read -r actual < /proc/sys/kernel/hostname || { echo 'Cannot read router hostname; use --force to bypass the check' >&2; exit 1; }
    [ \"\$actual\" = '$name' ] || {
        printf 'Router hostname mismatch: expected %s, got %s. Use --force to proceed anyway.\\n' '$name' \"\$actual\" >&2
        exit 1
    }
fi"

temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# Finish the archive before SSH so local read failures cannot start installation.
tar -czf "$temporary/config.tar.gz" -C "$repo/$name" -- "${archive_files[@]}"

# The router only needs its standard /bin/sh, not Bash, Python, or nohup.
remote_install=$(cat <<'REMOTE'
set -eu
umask 077
fail() { echo "openwrt_pushconfig: $*" >&2; exit 1; }
for tool in uci awk tar cmp mktemp cp mv ubus sleep; do
    command -v "$tool" >/dev/null || fail "Missing router dependency: $tool (configuration unchanged)"
done
mkdir /tmp/openwrt-pushconfig.lock || fail 'Another push is running (or a stale lock exists)'
work=
backup=
installing=0
apk_installing=0
cleanup() {
    status=$?
    trap - EXIT
    if [ "$installing" = 1 ]; then
        for file in "$work"/new/etc/config/*; do
            name=${file##*/}
            if [ -f "$backup/config/$name" ]; then
                cp -p "$backup/config/$name" "/etc/config/$name" || status=1
            else
                rm -f "/etc/config/$name" || status=1
            fi
        done
        echo "openwrt_pushconfig: Installation failed; attempted restore from $backup" >&2
    fi
    if [ "$apk_installing" = 1 ]; then
        rm -rf /etc/apk
        cp -Rp "$backup/apk" /etc/apk || status=1
        echo "APK configuration restored; package changes may remain. Backup: $backup" >&2
    fi
    rm -f /etc/config/.openwrt_pushconfig.$$
    [ -z "$work" ] || rm -rf "$work"
    rmdir /tmp/openwrt-pushconfig.lock
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
work=$(mktemp -d /tmp/openwrt-pushconfig.XXXXXX)
mkdir "$work/new" "$work/delta"
tar -xzf - -C "$work/new"
changes=$(uci changes 2>/dev/null) || fail 'Cannot inspect pending UCI changes'
[ -z "$changes" ] || fail 'Commit or revert pending UCI changes first (configuration unchanged)'
for file in "$work"/new/etc/config/*; do
    name=${file##*/}
    [ ! -L "/etc/config/$name" ] || fail 'Router configuration contains a symbolic link'
    [ ! -e "/etc/config/$name" ] || [ -f "/etc/config/$name" ] || fail 'Router package is not a regular file'
    uci -c "$work/new/etc/config" -t "$work/delta" export "$name" >/dev/null 2>&1 || fail "Invalid UCI package: $name (configuration unchanged)"
done
# Validate and merge entirely in the temporary upload before APK or live writes.
policy=
[ ! -f "$work/new/secret-options" ] || policy="$work/new/secret-options"
for file in "$work"/new/etc/config/*; do
    package=${file##*/}
    uci -q -c "$work/new/etc/config" -t "$work/delta" -N export "$package" > "$work/export" 2>/dev/null || fail "Invalid UCI package: $package"
    secrets_filter check "$package" "$policy" '' < "$file" >/dev/null || fail "Move inline secrets to ignored secrets/$package before pushing"
    if [ -f "/etc/config/$package" ]; then
        merge_secrets "$work/new/etc/config" /etc/config "$package" "$policy" preserve
    fi
    if [ -f "$work/new/secrets/$package" ]; then
        uci -q -c "$work/new/secrets" -t "$work/delta" -N export "$package" > "$work/export" 2>/dev/null || fail "Invalid secret override: $package"
        secrets_filter overlay "$package" "$policy" '' < "$work/new/secrets/$package" >/dev/null || fail "Invalid secret override: $package"
        merge_secrets "$work/new/etc/config" "$work/new/secrets" "$package" "$policy" override
    fi
    uci -q -c "$work/new/etc/config" -t "$work/delta" export "$package" >/dev/null 2>&1 || fail "Invalid merged UCI package: $package"
done
if [ -f "$work/new/secret-paths" ]; then
    while read -r path type extra; do
        [ -n "$path" ] || continue
        case "$path" in *[!a-zA-Z0-9_.@\[\]-]*|*.*.*.*|.*|*.|*..*) fail 'Invalid secret-paths entry' ;; esac
        case "$type" in ''|*[!a-zA-Z0-9_-]*) fail 'Invalid secret-paths section type' ;; esac
        [ -z "$extra" ] || fail 'Invalid secret-paths entry'
        case "$path" in *.*.*) ;; *) fail 'Invalid secret-paths entry' ;; esac
        package=${path%%.*}; section=${path%.*}
        option=${path##*.}
        case "$package:$option" in *[!a-zA-Z0-9_:]*|:*|*:) fail 'Invalid secret-paths entry' ;; esac
        ref=${section#*.}
        case "$ref" in
            @*) printf '%s\n' "$ref" | awk '/^@[a-zA-Z0-9_-]+\[[0-9]+\]$/ { valid=1 } END { exit !valid }' || fail "Invalid anonymous secret reference: $ref" ;;
            ''|*[!a-zA-Z0-9_]*) fail 'Invalid secret section name' ;;
        esac
        [ -f "$work/new/etc/config/$package" ] || continue
        target_type=$(uci -q -c "$work/new/etc/config" -t "$work/delta" get "$section") || continue
        [ "$target_type" = "$type" ] || fail "Secret section type mismatch: $section"
        uci -q -c "$work/new/etc/config" -t "$work/delta" show "$path" >/dev/null 2>&1 || fail "Missing required secret: $path (provide secrets/$package)"
    done < "$work/new/secret-paths"
fi
# Newly created secured Wi-Fi and WireGuard interfaces also need credentials.
for file in "$work"/new/etc/config/*; do
    package=${file##*/}
    uci -q -c "$work/new/etc/config" -t "$work/delta" -N export "$package" > "$work/export" 2>/dev/null
    secrets_filter sections "$package" "$policy" '' < "$work/export" > "$work/sections" || fail 'Cannot inspect sections'
    while read -r section type; do
        option=
        if [ "$package" = wireless ] && [ "$type" = wifi-iface ]; then
            encryption=$(uci -q -c "$work/new/etc/config" -t "$work/delta" get "$section.encryption") || encryption=
            case "$encryption" in *psk*|*sae*|wep*) option=key ;; esac
        elif [ "$package" = network ] && [ "$type" = interface ]; then
            proto=$(uci -q -c "$work/new/etc/config" -t "$work/delta" get "$section.proto") || proto=
            [ "$proto" != wireguard ] || option=private_key
        fi
        [ -z "$option" ] || uci -q -c "$work/new/etc/config" -t "$work/delta" show "$section.$option" >/dev/null 2>&1 || fail "Missing required secret: $section.$option"
    done < "$work/sections"
done
backup=$(mktemp -d /root/openwrt-config-backup.XXXXXX)
cp -Rp /etc/config "$backup/config"
if [ -d "$work/new/etc/apk" ]; then
    command -v apk >/dev/null || fail 'Router has no apk (configuration unchanged)'
    [ -d /etc/apk ] && [ ! -L /etc/apk ] || fail 'Expected a real /etc/apk directory'
    cp -Rp /etc/apk "$backup/apk"
    apk_installing=1
    rm -rf /etc/apk
    cp -Rp "$work/new/etc/apk" /etc/apk
    apk update || fail 'APK repository update failed'
    # With no arguments, add commits the restored world without marking any
    # package for upgrade or reinstall. The solver installs missing requirements
    # and removes packages no longer needed, retaining required dependencies.
    apk add -- || fail 'APK package synchronization failed'
    echo 'APK packages synchronized with saved world.'
fi
installing=1
set --
for file in "$work"/new/etc/config/*; do
    name=${file##*/}
    cp "$file" /etc/config/.openwrt_pushconfig.$$
    chmod 600 /etc/config/.openwrt_pushconfig.$$
    mv -f /etc/config/.openwrt_pushconfig.$$ "/etc/config/$name"
    cmp -s "$file" "/etc/config/$name" || fail "Installed configuration differs from upload: $name"
    set -- "$@" "$name"
done
installing=0
apk_installing=0
# Ignore SSH hangup using the shell builtin instead of the optional nohup applet.
# Set this before forking so there is no race with the SSH session closing.
trap '' HUP
(
    trap - EXIT INT TERM
    sleep 2
    result=0
    for name do
        if ubus call service event "{\"type\":\"config.change\",\"data\":{\"package\":\"$name\"}}"; then
            echo "Reload requested: $name"
        else
            echo "Reload request failed: $name" >&2
            result=1
        fi
    done
    echo "Service reload requests exit status: $result"
    exit "$result"
) >"$backup/apply.log" 2>&1 </dev/null &
trap 'exit 143' HUP
echo "Configuration installed and verified ($# packages). Backup: $backup/config"
echo "Service reload scheduled; router log: $backup/apply.log"
REMOTE
)
remote_install="$remote_guard
$remote_secrets
$remote_install"
printf 'Uploading %s configuration package(s) to %s...\n' "${#files[@]}" "$host"
if ! { printf '%s\n' "$remote_install" __OPENWRT_SCRIPT_END__; cat -- "$temporary/config.tar.gz"; } | ssh -T -- "$host" "$remote_bootstrap"; then
    die 'Push failed; see the router error above. Installation is only confirmed by "Configuration installed and verified".'
fi
