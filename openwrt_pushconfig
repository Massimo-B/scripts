#!/usr/bin/env bash
# BEGIN SCRIPT VERSION
# Source version: 2026-10-06 (Git 5713c69)
if [[ "${BASH_SOURCE[0]}" == "$0" && "${1-}" == --version ]]; then
    printf '%s %s (Git %s)\n' 'openwrt_pushconfig' '2026-10-06' '5713c69'
    exit 0
fi
# END SCRIPT VERSION
# Copy local UCI files unchanged to OpenWrt, then reload affected services.
set -euo pipefail
umask 077

usage() {
    cat <<'EOF'
Usage: openwrt_pushconfig [--name NAME] SSH_HOST REPOSITORY

Copy REPOSITORY/NAME/etc/config to /etc/config on OpenWrt over SSH.
NAME defaults to openwrt. Files, including secrets, are copied unchanged.
Files absent locally are retained on the router. Old [REDACTED] snapshots
must be replaced with complete configuration files before pushing.

The router validates the files with UCI, backs up /etc/config under /root,
installs and verifies the upload, and schedules service reloads. Network
changes may disconnect clients or change the router address.

Options:
  --name NAME  Source directory name inside the repository
  --version    Show source date and Git commit ID
  -h, --help   Show this help
EOF
}

die() { printf 'openwrt_pushconfig: %s\n' "$*" >&2; exit 1; }

name=openwrt
while (($#)); do
    case "$1" in
        --name)
            (($# >= 2)) || die '--name requires a value'
            name=$2
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) die "Unknown option: $1" ;;
        *) break ;;
    esac
done
(($# == 2)) || { usage >&2; exit 1; }
[[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die 'Invalid NAME'
host=$1
[[ -n "$host" && "$host" != -* ]] || die 'Invalid SSH host'
for command in ssh git tar mktemp realpath grep; do
    command -v "$command" >/dev/null || die "Missing dependency: $command"
done
repo=$(git -C "$2" rev-parse --show-toplevel) || die 'REPOSITORY must be a Git working tree'
repo=$(realpath -- "$repo")
source_config="$repo/$name/etc/config"
for path in "$repo/$name" "$repo/$name/etc" "$source_config"; do
    [[ -d "$path" && ! -L "$path" ]] || die "Expected a real directory: $path"
done
files=()
shopt -s nullglob dotglob
for file in "$source_config"/*; do
    package=${file##*/}
    [[ "$package" == .git ]] && continue
    [[ "$package" =~ ^[a-zA-Z0-9_]+$ && -f "$file" && ! -L "$file" ]] || die "Expected a regular UCI package: $package"
    if grep -Fq '[REDACTED]' "$file"; then
        die "Package $package contains old [REDACTED] placeholders; restore complete values before pushing"
    fi
    files+=("$package")
done
((${#files[@]})) || die 'No configuration files to push'
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# Finish the archive before SSH so local read failures cannot start installation.
tar -czf "$temporary/config.tar.gz" -C "$source_config" -- "${files[@]}"

# The router only needs its standard /bin/sh, not Bash, Python, or nohup.
remote_install=$(cat <<'REMOTE'
set -eu
umask 077
fail() { echo "openwrt_pushconfig: $*" >&2; exit 1; }
for tool in uci tar cmp mktemp cp mv ubus sleep; do
    command -v "$tool" >/dev/null || fail "Missing router dependency: $tool (configuration unchanged)"
done
mkdir /tmp/openwrt-pushconfig.lock || fail 'Another push is running (or a stale lock exists)'
work=
backup=
installing=0
cleanup() {
    status=$?
    trap - EXIT
    if [ "$installing" = 1 ]; then
        for file in "$work"/new/*; do
            name=${file##*/}
            if [ -f "$backup/config/$name" ]; then
                cp -p "$backup/config/$name" "/etc/config/$name" || status=1
            else
                rm -f "/etc/config/$name" || status=1
            fi
        done
        echo "openwrt_pushconfig: Installation failed; attempted restore from $backup" >&2
    fi
    rm -f /etc/config/.openwrt_pushconfig.$$
    [ -z "$work" ] || rm -rf "$work"
    rmdir /tmp/openwrt-pushconfig.lock
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
work=$(mktemp -d /tmp/openwrt-pushconfig.XXXXXX)
mkdir "$work/new" "$work/delta"
tar -xzf - -C "$work/new"
changes=$(uci changes 2>/dev/null) || fail 'Cannot inspect pending UCI changes'
[ -z "$changes" ] || fail 'Commit or revert pending UCI changes first (configuration unchanged)'
for file in "$work"/new/*; do
    name=${file##*/}
    [ ! -L "/etc/config/$name" ] || fail 'Router configuration contains a symbolic link'
    [ ! -e "/etc/config/$name" ] || [ -f "/etc/config/$name" ] || fail 'Router package is not a regular file'
    uci -c "$work/new" -P "$work/delta" export "$name" >/dev/null 2>&1 || fail "Invalid UCI package: $name (configuration unchanged)"
done
backup=$(mktemp -d /root/openwrt-config-backup.XXXXXX)
cp -Rp /etc/config "$backup/config"
installing=1
set --
for file in "$work"/new/*; do
    name=${file##*/}
    cp "$file" /etc/config/.openwrt_pushconfig.$$
    chmod 600 /etc/config/.openwrt_pushconfig.$$
    mv -f /etc/config/.openwrt_pushconfig.$$ "/etc/config/$name"
    cmp -s "$file" "/etc/config/$name" || fail "Installed configuration differs from upload: $name"
    set -- "$@" "$name"
done
installing=0
# Ignore SSH hangup using the shell builtin instead of the optional nohup applet.
# Set this before forking so there is no race with the SSH session closing.
trap '' HUP
(
    trap - EXIT INT TERM
    sleep 2
    result=0
    for name do
        if ubus call service event "{\"type\":\"config.change\",\"data\":{\"package\":\"$name\"}}"; then
            echo "Reload requested: $name"
        else
            echo "Reload request failed: $name" >&2
            result=1
        fi
    done
    echo "Service reload requests exit status: $result"
    exit "$result"
) >"$backup/apply.log" 2>&1 </dev/null &
trap 'exit 143' HUP
echo "Configuration installed and verified ($# packages). Backup: $backup/config"
echo "Service reload scheduled; router log: $backup/apply.log"
REMOTE
)
printf 'Uploading %s configuration package(s) to %s...\n' "${#files[@]}" "$host"
if ! ssh -T -- "$host" "$remote_install" < "$temporary/config.tar.gz"; then
    die 'Push failed; see the router error above. Installation is only confirmed by "Configuration installed and verified".'
fi
