#!/usr/bin/env bash
# BEGIN SCRIPT VERSION
# Source version: 2026-10-14 (Git acc7fec+uncommitted)
if [[ "${BASH_SOURCE[0]}" == "$0" && "${1-}" == --version ]]; then
    printf '%s %s (Git %s)\n' 'openwrt_secrets' '2026-10-14' 'acc7fec+uncommitted'
    exit 0
fi
# END SCRIPT VERSION
set -euo pipefail
umask 077

remote_source() {
cat <<'REMOTE'
# UCI values are interpreted by UCI, never evaluated as shell commands.
# The lexer reads UCI export/config statements including quoted multiline values.
secrets_filter() {
    # Arguments: mode, package, extra option names file, manifest, selected path.
    awk -v mode="$1" -v package="$2" -v rules="$3" -v manifest="$4" -v selected="${5-}" '
    function error(message) {
        print "openwrt_secrets: " package ": " message > "/dev/stderr"
        failed=1
        exit 1
    }
    function finish_token() {
        if (active) { token[++count]=value; value=""; active=0 }
    }
    function statement(  command, option, path, secret, i) {
        finish_token()
        command=token[1]
        if (!count) { raw=""; return }
        if (command=="package") {
            if (count!=2 || token[2]!=package) error("unexpected package declaration")
        } else if (command=="config") {
            if (count<2 || count>3 || token[2] !~ /^[a-zA-Z0-9_-]+$/ ||
                (count==3 && token[3] !~ /^[a-zA-Z0-9_]+$/)) error("invalid section declaration")
            section=token[3]; type=token[2]; header=raw
            if (mode=="public") print raw
            ref=section
            if (section=="") ref="@" type "[" type_count[type] "]"
            type_count[type]++
            if (mode=="sections") print package "." ref " " type
        } else if (command=="option" || command=="list") {
            if (count!=3 || type=="" || token[2] !~ /^[a-zA-Z0-9_]+$/) error("invalid option declaration")
            option=token[2]; secret=(option in protected)
            path=package "." section "." option
            if (secret && section=="") error("secret option " option " needs a named section")
            if (secret && manifest!="" && !seen[path]++) print path " " type >> manifest
            if (mode=="check" && secret) error("secret option " path " belongs in NAME/secrets/" )
            if (mode=="overlay" && secret && token[3]=="") error("empty secret override " path " is not supported by UCI")
            if (mode=="overlay" && !secret) error("non-secret option " path " is not allowed in secrets/")
            if ((mode=="public" && !secret) ||
                ((mode=="private" || mode=="overlay") && secret) ||
                (mode=="one" && path==selected)) {
                if (mode!="public" && !emitted[section]++) print header
                print raw
            }
        } else error("unsupported UCI statement")
        for (i in token) delete token[i]
        count=0; raw=""
    }
    BEGIN {
        names="password passwd key key1 key2 key3 key4 secret token psk private_key preshared_key client_secret auth_secret radius_secret acct_secret auth_key acct_key sae_password wpa_psk shared_secret api_key access_token refresh_token tls_auth tls_crypt"
        n=split(names, defaults, " ")
        for (i=1;i<=n;i++) protected[defaults[i]]=1
        if (rules!="") {
            while ((rule_status=getline line < rules)>0) {
                sub(/#.*/, "", line); gsub(/^[ \t]+|[ \t\r]+$/, "", line)
                if (line=="") continue
                if (line !~ /^[a-zA-Z0-9_]+$/) error("invalid extra secret option name")
                protected[line]=1
            }
            if (rule_status<0) error("cannot read extra secret option names")
            close(rules)
        }
    }
    {
        line=$0 "\n"
        for (pos=1;pos<=length(line);pos++) {
            c=substr(line,pos,1)
            if (comment) { if (c=="\n") { comment=0; statement() }; continue }
            raw=raw c
            if (escaped) { if (c!="\n") value=value c; escaped=0; continue }
            if (quote!="") {
                if (c==quote) quote=""
                else if (quote=="\"" && c=="\\") escaped=1
                else value=value c
                continue
            }
            if (c=="\\") { escaped=1; active=1 }
            else if (c=="\047" || c=="\"") { quote=c; active=1 }
            else if (c=="#") { raw=substr(raw,1,length(raw)-1); comment=1 }
            else if (c==";" || c=="\n") { raw=substr(raw,1,length(raw)-1); statement() }
            else if (c ~ /[ \t\r]/) finish_token()
            else { value=value c; active=1 }
        }
    }
    END {
        if (!failed && (quote!="" || escaped || count || active)) error("unterminated UCI statement")
        if (failed) exit 1
    }' 
}

# Merge one protected option at a time through UCI import. This preserves lists,
# quotes, backslashes, and trailing newlines without shell eval.
merge_secrets() {
    target=$1; source=$2; package=$3; policy=$4; merge_mode=$5
    : > "$work/merge.paths"
    uci -c "$source" -t "$work/delta" -N export "$package" > "$work/merge.export" 2>/dev/null || fail "Cannot read secret source: $package"
    secrets_filter private "$package" "$policy" "$work/merge.paths" < "$work/merge.export" > "$work/merge.private" || fail "Invalid secret source: $package"
    while read -r path type extra; do
        section=${path%.*}
        target_type=$(uci -q -c "$target" -t "$work/delta" get "$section") || {
            [ "$merge_mode" = preserve ] && continue
            fail "Secret override section missing: $section"
        }
        [ "$target_type" = "$type" ] || fail "Secret section type mismatch: $section"
        # Explicit overrides replace lists instead of appending to old values.
        uci -q -c "$target" -t "$work/delta" delete "$path" >/dev/null 2>&1 || :
        secrets_filter one "$package" "$policy" '' "$path" < "$work/merge.private" > "$work/merge.one" || fail "Cannot prepare secret: $path"
        uci -q -c "$target" -t "$work/delta" -m import "$package" < "$work/merge.one" >/dev/null 2>&1 || fail "Cannot merge secret: $path"
        uci -q -c "$target" -t "$work/delta" commit "$package" >/dev/null 2>&1 || fail "Cannot commit temporary secret: $path"
    done < "$work/merge.paths"
}
REMOTE
}

usage() {
    cat <<'HELP'
Usage: openwrt_secrets --check REPOSITORY
       openwrt_secrets --check-staged REPOSITORY
       openwrt_secrets --install-hook REPOSITORY

Check known secret options in NAME/etc/config files, or install a pre-commit
check in a router configuration repository. Add custom secret option names
(one per line) to NAME/secret-options. Store overrides in ignored NAME/secrets/.
The check reports paths only, never values. --install-hook refuses to replace
an existing pre-commit hook; integrate --check-staged there yourself instead.
HELP
}
[[ ${1-} != --remote-source ]] || { remote_source; exit; }
[[ ${1-} != -h && ${1-} != --help ]] || { usage; exit; }
[[ $# == 2 ]] || { usage >&2; exit 1; }
mode=$1
repo=$(git -C "$2" rev-parse --show-toplevel)
repo=$(realpath -- "$repo")
if [[ $mode == --install-hook ]]; then
    hooks=$(git -C "$repo" rev-parse --git-path hooks)
    [[ $hooks == /* ]] || hooks="$repo/$hooks"
    mkdir -p -- "$hooks"
    [[ ! -e "$hooks/pre-commit" && ! -L "$hooks/pre-commit" ]] || { echo 'Existing pre-commit hook: add openwrt_secrets --check-staged yourself.' >&2; exit 1; }
    [[ ! -L "$hooks/openwrt-secrets-check" ]] || { echo 'Hook checker must not be a symbolic link.' >&2; exit 1; }
    cp -- "${BASH_SOURCE[0]}" "$hooks/openwrt-secrets-check"
    chmod 700 "$hooks/openwrt-secrets-check"
    cat > "$hooks/pre-commit" <<'HOOK'
#!/usr/bin/env bash
set -euo pipefail
hooks=$(git rev-parse --git-path hooks)
exec "$hooks/openwrt-secrets-check" --check-staged .
HOOK
    chmod 700 "$hooks/pre-commit"
    printf 'Installed secret check in %s/pre-commit\n' "$hooks"
    exit
fi
[[ $mode == --check || $mode == --check-staged ]] || { usage >&2; exit 1; }
source /dev/stdin <<< "$(remote_source)"
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT
failed=0
if [[ $mode == --check-staged ]]; then
    git -C "$repo" ls-files -z > "$temporary/files"
else
    git -C "$repo" ls-files --cached --others --exclude-standard -z > "$temporary/files"
fi
while IFS= read -r -d '' path; do
    if [[ $path == */secrets/* ]]; then
        echo "Secret file must not be staged/tracked: $path" >&2
        failed=1
        continue
    fi
    [[ $path =~ ^([a-zA-Z0-9][a-zA-Z0-9._-]*)/etc/config/([a-zA-Z0-9_]+)$ ]] || continue
    name=${BASH_REMATCH[1]}; package=${BASH_REMATCH[2]}
    policy=
    if [[ $mode == --check-staged ]]; then
        git -C "$repo" show ":$path" > "$temporary/config"
        : > "$temporary/policy"
        if git -C "$repo" cat-file -e ":$name/secret-options" 2>/dev/null; then
            git -C "$repo" show ":$name/secret-options" >> "$temporary/policy"
        fi
        if [[ -f "$repo/$name/secret-options" && ! -L "$repo/$name/secret-options" ]]; then
            printf '\n' >> "$temporary/policy"
            cat -- "$repo/$name/secret-options" >> "$temporary/policy"
        fi
        policy="$temporary/policy"
    else
        [[ -f "$repo/$path" && ! -L "$repo/$path" ]] || { echo "Invalid config file: $path" >&2; failed=1; continue; }
        cp -- "$repo/$path" "$temporary/config"
        [[ ! -f "$repo/$name/secret-options" ]] || policy="$repo/$name/secret-options"
    fi
    if ! secrets_filter check "$package" "$policy" '' < "$temporary/config" >/dev/null; then
        echo "Secret check failed: $path" >&2
        failed=1
    fi
done < "$temporary/files"
exit "$failed"
