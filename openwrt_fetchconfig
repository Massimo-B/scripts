#!/usr/bin/env bash
# Copy OpenWrt's UCI configuration into a local Git working tree.
set -euo pipefail
umask 077

usage() {
    cat <<'EOF'
Usage: openwrt_fetchconfig [--name NAME] SSH_HOST REPOSITORY

Copy /etc/config from OpenWrt over SSH into REPOSITORY/NAME/etc/config.
NAME defaults to openwrt. Use distinct names when fetching from multiple routers.
SSH_HOST can be root@192.168.1.1 or an alias from ~/.ssh/config (including its
configured user, port, and identity file).

The destination config directory is mirrored: files removed on the router are
also removed locally. Local edits there are overwritten. Nothing is staged,
committed, or pushed. Common UCI password, key, token, and shared-secret fields
are replaced with [REDACTED] before copying. Custom secret fields may need to be
added to the redaction rules. Previously committed secrets remain in Git history.
The redacted copy is for review, not a complete restorable backup.

Options:
  --name NAME  Destination directory name inside the repository
  -h, --help   Show this help
EOF
}

die() { printf 'openwrt_fetchconfig: %s\n' "$*" >&2; exit 1; }

name=openwrt
while (($#)); do
    case "$1" in
        --name)
            (($# >= 2)) || die '--name requires a value'
            name=$2
            shift 2
            ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) die "Unknown option: $1" ;;
        *) break ;;
    esac
done
(($# == 2)) || { usage >&2; exit 1; }
[[ "$name" =~ ^[a-zA-Z0-9][a-zA-Z0-9._-]*$ ]] || die 'NAME must start with a letter or digit and contain only letters, digits, dots, underscores, or hyphens'
host=$1
[[ -n "$host" && "$host" != -* ]] || die 'Invalid SSH host'
for command in ssh git tar rsync mktemp realpath python3; do
    command -v "$command" >/dev/null || die "Missing dependency: $command"
done
repo=$(git -C "$2" rev-parse --show-toplevel) || die 'REPOSITORY must be a Git working tree'
repo=$(realpath -- "$repo")
destination="$repo/$name/etc/config"
# Refuse symlinked parents so the mirror cannot write outside the repository.
for path in "$repo/$name" "$repo/$name/etc" "$destination"; do
    [[ ! -L "$path" ]] || die "Destination must not be a symbolic link: $path"
    [[ ! -e "$path" || -d "$path" ]] || die "Destination is not a directory: $path"
done

temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
printf 'Fetching /etc/config from %s...\n' "$host"
# Download fully before touching the destination; -T prevents terminal output
# from corrupting the archive. No scp/SFTP or rsync is needed on the router.
ssh -T -- "$host" 'tar -czf - -C / etc/config' > "$temporary/config.tar.gz"

# Only accept the requested subtree, and keep Git metadata out of the mirror.
tar -tzf "$temporary/config.tar.gz" > "$temporary/members"
while IFS= read -r member; do
    case "$member" in
        etc/config|etc/config/|etc/config/*) ;;
        *) die "Unexpected archive path: $member" ;;
    esac
    case "/$member/" in
        */../*|*/.git/*) die "Unsafe archive path: $member" ;;
    esac
done < "$temporary/members"
mkdir "$temporary/extracted"
tar -xzf "$temporary/config.tar.gz" -C "$temporary/extracted" --no-same-owner --no-same-permissions
source_config="$temporary/extracted/etc/config"
[[ -d "$source_config" && ! -L "$source_config" ]] || die 'Archive does not contain an /etc/config directory'
# Sanitize the private temporary copy before creating or updating the mirror.
# Parse quoted values (including multiline values) instead of substituting only
# the first line of a secret. Never print values when reporting parse failures.
python3 - "$source_config" <<'PY'
import os
from pathlib import Path
import re
import shlex
import stat
import sys


def sensitive(name):
    name = name.lower()
    return (
        any(part in name for part in (
            "password", "passwd", "passphrase", "secret", "token", "credential",
        ))
        or re.search(r"(?:^|_)(?:key\d*|psk|pin|community)(?:_|$)", name)
        or name in {"pwd", "pass", "privatekey", "presharedkey"}
    )


def redact(path):
    result = []
    pending = ""
    with path.open(encoding="utf-8", errors="surrogateescape", newline="") as source:
        for line in source:
            pending += line
            try:
                fields = shlex.split(pending, comments=True, posix=True)
            except ValueError:
                # A quoted or escaped value can continue onto the next line.
                continue
            trailing = len(pending.rstrip("\r\n")) - len(pending.rstrip("\r\n").rstrip("\\"))
            if pending.endswith("\n") and trailing % 2:
                continue
            if fields:
                command = fields[0]
                if not (
                    (command in {"option", "list"} and len(fields) == 3)
                    or (command == "config" and len(fields) in {2, 3})
                    or (command == "package" and len(fields) == 2)
                ):
                    raise ValueError("Unsupported UCI statement")
                if command in {"option", "list"} and sensitive(fields[1]):
                    indent = re.match(r"[ \t]*", pending).group()
                    pending = f"{indent}{command} {shlex.quote(fields[1])} '[REDACTED]'\n"
            result.append(pending)
            pending = ""
    if pending:
        raise ValueError("Incomplete UCI statement")
    with path.open("w", encoding="utf-8", errors="surrogateescape", newline="") as target:
        target.write("".join(result))


try:
    for root, directories, files in os.walk(sys.argv[1], followlinks=False):
        for name in directories + files:
            path = Path(root) / name
            mode = path.lstat().st_mode
            if stat.S_ISDIR(mode):
                continue
            if not stat.S_ISREG(mode):
                raise ValueError("Non-regular configuration file")
            redact(path)
except (OSError, ValueError):
    sys.exit("openwrt_fetchconfig: Cannot safely redact configuration; destination unchanged")
PY
mkdir -p -- "$destination"
# Preserve executable bits, but restrict access to the local owner.
# Protect any local Git metadata even if a nested repository exists here.
rsync -rltp --checksum --chmod=Du=rwx,Dgo=,Fu=rwX,Fgo= --delete --exclude=.git -- "$source_config/" "$destination/"
printf 'Copied configuration to %s\n' "$destination"
git -C "$repo" status --short -- "$name/etc/config"
